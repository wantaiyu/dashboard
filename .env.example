# DigitalPlat 自动续期 - 示例配置
# 你只需要填这一个必填项,其余参数已内置默认值,无需设置

DIGITALPLAT_API_KEY=dp_live_xxxxxxxxxxxxxxxxx

# ---------- 以下全部可选(不设置即用内置默认) ----------
# DIGITALPLAT_BASE_URL=https://domain-api.digitalplat.org/api/v1
# RENEW_THRESHOLD_DAYS=120      # 到期前多少天内续期
# RENEW_YEARS=1                 # 每次续期年数
# RENEW_PAYMENT_METHOD=         # 统一支付方式;留空=按类型自动(free→free,其他→credits)
# RENEW_PAYMENT_FREE=free       # 免费域名支付方式
# RENEW_PAYMENT_PAID=credits    # 其他域名支付方式
# RENEW_DELAY_MS=300            # 每个续期请求间隔
# DRY_RUN=false                 # true=只预览不续期